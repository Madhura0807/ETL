# Copy to .env and fill in. NEVER commit .env.
# Option A: one full SQLAlchemy URL for the TARGET database
# ETL_TARGET_URL=mysql+pymysql://etl_user:change_me@localhost:3306/etl_db
# Option B: individual MySQL settings (used when ETL_TARGET_URL is not set)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=etl_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=etl_db

# SOURCE database for the SQL-extraction sample (products pipeline).
# Created locally by scripts/generate_sample_data.py (SQLite file, synthetic data).
SOURCE_DB_URL=sqlite:///data/raw/source.db
